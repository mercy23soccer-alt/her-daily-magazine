---
export async function getStaticPaths() {
  const posts = import.meta.glob("../../content/posts/*.md", { eager: true });
  return Object.entries(posts).map(([path, post]: [string, any]) => {
    const slug = path.split("/").pop().replace(".md", "");
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = post;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.frontmatter.date} 号 | Zazzy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@500;700&display=swap" rel="stylesheet" />
    
    <style is:inline>
      :root {
        --bg: #f9f8f6;
        --card-bg: #ffffff;
        --text: #2d312e;
        --sub-text: #767a77;
        --accent: #9d8161;
        --olive: #5d6d5f;
        --border: #e8e4dc;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; background-color: var(--bg); }
      body {
        color: var(--text);
        font-family: "Shippori Mincho", "Noto Sans JP", serif;
        line-height: 2.1;
        padding: 2.5rem 1rem 5rem;
        -webkit-font-smoothing: antialiased;
      }

      .magazine-page {
        max-width: 820px;
        margin: 0 auto;
        background-color: var(--card-bg);
        border: 1px solid var(--border);
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        padding: clamp(2rem, 5vw, 4rem);
        border-radius: 4px;
      }

      .folio-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.8rem;
      }
      .nav-btn {
        text-decoration: none;
        color: var(--text);
        font-family: "Noto Sans JP", sans-serif;
        font-size: 0.78rem;
        border: 1px solid var(--border);
        background: var(--bg);
        padding: 0.3rem 0.75rem;
        border-radius: 20px;
        transition: 0.15s;
      }
      .nav-btn:hover { background: #efece6; }

      .masthead {
        text-align: center;
        padding: 2.5rem 0 1.5rem;
        border-bottom: 1px solid var(--border);
      }
      .main-logo {
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(2.8rem, 8vw, 4.5rem);
        font-style: italic;
        font-weight: 500;
        color: var(--olive);
      }
      .issue-date {
        font-family: "Cormorant Garamond", serif;
        font-size: 1.1rem;
        color: var(--accent);
        margin-top: 0.3rem;
      }

      .article-content { margin-top: 2rem; }
      .article-content h2 {
        font-family: "Shippori Mincho", serif;
        font-size: 1.35rem;
        font-weight: 700;
        background: #fbfaf8;
        border-left: 4px solid var(--olive);
        padding: 0.5rem 1rem;
        margin: 3.5rem 0 1.4rem;
      }
      .article-content p {
        margin-bottom: 1.6rem;
        text-align: justify;
        font-size: 1.02rem;
      }
      .article-content a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid var(--accent);
      }
      .magazine-photo-box { margin: 2.8rem 0; }
      .magazine-photo-box img {
        width: 100%;
        height: auto;
        border-radius: 4px;
        border: 1px solid var(--border);
      }
      .photo-caption {
        font-size: 0.75rem;
        color: var(--sub-text);
        margin-top: 0.4rem;
        text-align: right;
      }

      .footer-deck {
        margin-top: 4rem;
        border-top: 1px solid var(--border);
        padding-top: 2rem;
        text-align: center;
        font-size: 0.78rem;
        color: var(--sub-text);
      }
    </style>
  </head>
  <body>
    <article class="magazine-page">
      <div class="folio-bar">
        <a href="/her-daily-magazine/archive/" class="nav-btn">← 目録（バックナンバー）へ</a>
        <a href="/her-daily-magazine/" class="nav-btn">最新号へ ↗</a>
      </div>

      <header class="masthead">
        <h1 class="main-logo">Zazzy</h1>
        <p class="issue-date">Archive Issue — {post.frontmatter.date}</p>
      </header>

      <main class="article-content">
        <Content />
      </main>

      <footer class="footer-deck">
        <p>© 2026 Zazzy — BACK NUMBER ARCHIVE.</p>
      </footer>
    </article>

    <script is:inline>
      document.querySelectorAll(".article-content a").forEach((link) => {
        if (link.hostname && link.hostname !== window.location.hostname) {
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        }
      });
    </script>
  </body>
</html>
