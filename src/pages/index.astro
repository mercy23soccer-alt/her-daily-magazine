---
const posts = import.meta.glob("../content/posts/*.md", { eager: true });
const postList: any[] = Object.values(posts);
postList.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const latest = postList[0];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zazzy | The Guide to a Better Life</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Noto+Serif+JP:wght@300;400;600&family=Shippori+Mincho:wght@400;600&display=swap" rel="stylesheet" />
    
    <style is:inline>
      :root {
        --paper: #faf8f5;
        --bg-desk: #eeece8;
        --ink: #262524;
        --sub-ink: #6b665f;
        --accent-sand: #d1b48c;
        --accent-sage: #5e7065;
        --accent-wine: #8c4351;
        --border-subtle: #e2ded6;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; background-color: var(--bg-desk); }
      body {
        color: var(--ink);
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        line-height: 2.05;
        letter-spacing: 0.03em;
        padding: 2.5rem 1rem 5rem;
        -webkit-font-smoothing: antialiased;
      }

      .magazine-sheet {
        max-width: 860px;
        margin: 0 auto;
        background-color: var(--paper);
        border: 1px solid var(--border-subtle);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        padding: clamp(2rem, 5vw, 4.5rem);
      }

      .top-folio {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-subtle);
        padding-bottom: 0.8rem;
        font-family: "Cormorant Garamond", serif;
        font-size: 0.95rem;
        letter-spacing: 0.08em;
      }
      .location-badge {
        font-family: "Shippori Mincho", serif;
        font-size: 0.75rem;
        color: var(--sub-ink);
      }

      .masthead {
        text-align: center;
        padding: 3.5rem 0 2.5rem;
        border-bottom: 1px solid var(--border-subtle);
      }
      .journal-sub {
        font-family: "Cormorant Garamond", serif;
        font-size: 0.9rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--sub-ink);
        margin-bottom: 0.8rem;
      }
      .brand-logo {
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(3.8rem, 11vw, 6.2rem);
        font-weight: 600;
        font-style: italic;
        line-height: 0.92;
        letter-spacing: -0.01em;
        color: var(--ink);
      }
      .issue-details {
        margin-top: 1.2rem;
        font-size: 0.8rem;
        color: var(--sub-ink);
        display: flex;
        justify-content: center;
        gap: 1.5rem;
      }

      .editorial-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        padding: 1.4rem 0;
        border-bottom: 1px dashed var(--border-subtle);
      }
      .nav-tag {
        font-size: 0.72rem;
        text-decoration: none;
        color: var(--ink);
        background: #f2eee9;
        padding: 0.25rem 0.65rem;
        border-radius: 2px;
        transition: 0.15s;
      }
      .nav-tag:hover, .nav-tag.highlight {
        background: var(--accent-sand);
        color: #fff;
      }

      .radio-lounge {
        background: #f3efe9;
        border: 1px solid var(--border-subtle);
        padding: 0.9rem 1.4rem;
        margin: 1.8rem 0 3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 4px;
        gap: 1rem;
      }
      .radio-btn {
        background: var(--ink);
        color: var(--paper);
        border: none;
        font-family: "Cormorant Garamond", serif;
        font-size: 0.95rem;
        padding: 0.4rem 1.1rem;
        border-radius: 2px;
        cursor: pointer;
        letter-spacing: 0.05em;
        transition: 0.15s;
      }
      .radio-btn:hover { background: var(--accent-sage); }
      .radio-status {
        font-size: 0.75rem;
        color: var(--sub-ink);
      }

      .article-content { margin-top: 1.5rem; }
      .article-content h2 {
        font-family: "Cormorant Garamond", serif;
        font-size: 1.45rem;
        font-weight: 600;
        border-bottom: 1px solid var(--ink);
        padding-bottom: 0.4rem;
        margin: 4.5rem 0 1.6rem;
        letter-spacing: 0.05em;
        scroll-margin-top: 2rem;
      }
      #ocd-recovery {
        border-bottom: 2px solid var(--accent-wine) !important;
        color: var(--accent-wine) !important;
      }

      .article-content h3 {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 2rem 0 0.8rem;
        color: var(--ink);
      }
      .article-content p {
        margin-bottom: 1.6rem;
        text-align: justify;
        font-size: 0.96rem;
        color: #33312e;
      }

      .magazine-photo-box { margin: 3.5rem 0; }
      .magazine-photo-box img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 2px;
      }
      .photo-caption {
        font-family: "Cormorant Garamond", serif;
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        color: var(--sub-ink);
        margin-top: 0.6rem;
        text-align: right;
      }

      .article-content a {
        color: var(--accent-wine);
        text-decoration: none;
        border-bottom: 1px solid var(--accent-wine);
        padding-bottom: 1px;
        transition: 0.12s;
      }
      .article-content a:hover { background: #f7e8eb; }
      .article-content ul, .article-content ol { margin: 1.2rem 0 1.8rem 1.4rem; }
      .article-content li { margin-bottom: 0.7rem; font-size: 0.95rem; }

      .colophon {
        margin-top: 5rem;
        border-top: 1px solid var(--border-subtle);
        padding-top: 2rem;
        text-align: center;
        font-family: "Cormorant Garamond", serif;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        color: var(--sub-ink);
      }

      @media (max-width: 600px) {
        body { padding: 1rem 0.5rem 3rem; }
        .magazine-sheet { padding: 1.8rem 1.2rem; }
        .radio-lounge { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
      }
    </style>
  </head>
  <body>
    <article class="magazine-sheet">
      <div class="top-folio">
        <span>ZAZZY — FOR A BETTER & SIMPLE LIFE</span>
        <span class="location-badge">流山おおたかの森 · {latest ? latest.frontmatter.date : ""}</span>
      </div>

      <header class="masthead">
        <p class="journal-sub">A DAILY CHRONICLE FOR SIMPLE LIVING, MIND & CULTURE</p>
        <h1 class="brand-logo">Zazzy</h1>
        <div class="issue-details">
          <span>TEMPERATURE: {latest ? latest.frontmatter.temp : ""}</span>
          <span>·</span>
          <span>SUNSET: {latest ? latest.frontmatter.sunset : ""}</span>
        </div>
      </header>

      <nav class="editorial-nav">
        <a href="#simplicity" class="nav-tag">01 シンプリストの心得</a>
        <a href="#ocd-recovery" class="nav-tag highlight">★ 02 OCD・思考調律コラム</a>
        <a href="#comedy" class="nav-tag">03 お笑いラジオ・YouTube</a>
        <a href="#hiphop" class="nav-tag">04 クラシックHip-Hop</a>
        <a href="#baby" class="nav-tag">05 赤ちゃん情報3選</a>
        <a href="#fashion" class="nav-tag">06 ユニクロ・GU</a>
        <a href="#local-cafe" class="nav-tag">07 おおたかの森・カフェ</a>
        <a href="#sauna" class="nav-tag">08 周辺サウナ・スパ</a>
        <a href="#evidence" class="nav-tag">09 論文ウェルネス</a>
      </nav>

      <div class="radio-lounge">
        <div>
          <button id="radio-toggle" class="radio-btn">▶ PLAY MORNING AUDIO</button>
        </div>
        <div id="radio-status" class="radio-status">AUDIO SYNTHESIS : STANDBY</div>
      </div>

      <main id="article-content" class="article-content">
        {latest ? (
          <latest.Content />
        ) : (
          <p>朝刊を発行中です。Actionsから実行してください。</p>
        )}
      </main>

      <footer class="colophon">
        <p>© 2026 Zazzy — PRINTED DIGITALLY FOR PRIVATE LIVING.</p>
      </footer>
    </article>

    <script is:inline>
      document.querySelectorAll("#article-content a").forEach((link) => {
        if (link.hostname && link.hostname !== window.location.hostname) {
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        }
      });

      function splitTextIntoChunks(text, maxLen = 90) {
        const sentences = text.split(/(?<=[。！？\n])/);
        const chunks = [];
        let current = "";
        for (const s of sentences) {
          if (!s.trim()) continue;
          if ((current + s).length > maxLen) {
            if (current) chunks.push(current.trim());
            current = s;
          } else {
            current += s;
          }
        }
        if (current.trim()) chunks.push(current.trim());
        return chunks;
      }

      const btn = document.getElementById("radio-toggle");
      const status = document.getElementById("radio-status");
      let isPlaying = false;
      let chunks = [];
      let currentIdx = 0;

      function stopRadio() {
        window.speechSynthesis.cancel();
        isPlaying = false;
        btn.innerText = "▶ PLAY MORNING AUDIO";
        status.innerText = "AUDIO SYNTHESIS : STOPPED";
      }

      function speakNextChunk() {
        if (!isPlaying) return;
        if (currentIdx >= chunks.length) {
          isPlaying = false;
          btn.innerText = "▶ PLAY MORNING AUDIO";
          status.innerText = "BROADCAST COMPLETED";
          return;
        }

        const utterance = new SpeechSynthesisUtterance(chunks[currentIdx]);
        utterance.lang = "ja-JP";
        utterance.rate = 1.02;

        utterance.onend = () => {
          currentIdx++;
          speakNextChunk();
        };

        utterance.onerror = () => {
          currentIdx++;
          if (currentIdx < chunks.length) speakNextChunk();
          else stopRadio();
        };

        window.speechSynthesis.speak(utterance);
      }

      btn.addEventListener("click", () => {
        if (!("speechSynthesis" in window)) {
          alert("お使いのブラウザは音声読み上げに対応していません。");
          return;
        }

        if (isPlaying) {
          stopRadio();
          return;
        }

        const content = document.getElementById("article-content");
        if (!content) return;

        const rawText = content.innerText
          .replace(/https?:\/\/\S+/g, "")
          .replace(/[#*`_■§➔▲★]/g, "")
          .trim();

        chunks = splitTextIntoChunks(rawText, 90);
        if (chunks.length === 0) return;

        window.speechSynthesis.cancel();
        isPlaying = true;
        currentIdx = 0;
        btn.innerText = "⏹ STOP AUDIO";
        status.innerText = "READING MORNING ISSUE...";

        speakNextChunk();
      });
    </script>
  </body>
</html>
